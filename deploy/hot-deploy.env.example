# Copy outside the repository and adjust for the target host.
# Do not store SMOKE_API_KEY in this file; supply it through the environment.

CADDY_CONTAINER=sub2api-caddy
CADDY_ADMIN_URL=http://127.0.0.1:2019/config/
CADDYFILE=/opt/sub2api/deploy/Caddyfile.zhumeng
PUBLIC_BASE_URL=https://api.5566676.xyz

APP_PORT=8080
HEALTH_PATH=/health
RESPONSES_PATH=/responses
COMPACT_PATH=/responses
CONTAINER_PREFIX=sub2api-next
SMOKE_MODEL=gpt-5.6-sol
SMOKE_USER_AGENT=codex_cli_rs/hot-deploy
SMOKE_ORIGINATOR=codex_cli_rs

STATE_DIR=/opt/sub2api/deploy/hot-deploy-state
LOCK_FILE=/var/lock/sub2api-hot-deploy
HEALTH_TIMEOUT_SECONDS=180
HEALTH_POLL_INTERVAL_SECONDS=2
REQUEST_TIMEOUT_SECONDS=180
SOAK_SECONDS=30
SOAK_INTERVAL_SECONDS=5
COMPACT_SMOKE_BYTES=1048576
CANDIDATE_STOP_TIMEOUT_SECONDS=10
