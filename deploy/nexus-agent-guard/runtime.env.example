GUARD_IMAGE_TAG=local
UPSTREAM_URL=http://sub2api-next-v9:8080
SUB2API_ADMIN_KEY=replace-with-the-real-sub2api-admin-key
GUARD_API_KEY=replace-with-a-random-value-of-at-least-32-characters
