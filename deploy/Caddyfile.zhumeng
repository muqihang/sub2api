# Caddy 反代 - Cloudflare Full(strict) 端到端 HTTPS
# 三个域名 + 大陆拦截策略（基于 CF 透传的 CF-IPCountry header）
#
# 策略：
#   www.5566676.xyz / 5566676.xyz  → 拦截 CN（裸网络访问），翻墙后可访问
#   api.5566676.xyz                → 不拦截 CN，但只放行 AI 网关路径

{
	auto_https disable_redirects
}

# --- 公共反代片段（用 snippet 减少重复）-----------------------------------
(reverse_to_sub2api) {
	reverse_proxy sub2api:8080 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
		header_up CF-IPCountry {http.request.header.CF-IPCountry}

		transport http {
			keepalive 120s
			keepalive_idle_conns 256
			read_buffer 16KB
			write_buffer 16KB
		}

		health_uri /health
		health_interval 30s
		health_timeout 10s
		health_status 200
	}
}

(common_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# 调试：把 CF 透传的国家代码回写出来，部署后立刻可验证（验证完可删）
		X-Detected-Country "{http.request.header.CF-IPCountry}"
		-Server
	}
}

(common_encoding) {
	encode zstd gzip
	request_body {
		max_size 256MB
	}
}

# --- 后台域名：拦截大陆 IP ------------------------------------------------
www.5566676.xyz, 5566676.xyz {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	# 静态资源缓存
	@static {
		path /assets/*
		path /logo.png
		path /favicon.ico
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# 关键拦截规则：CF 标识 IP 来自 CN → 451 (Unavailable for legal reasons)
	@cn_block {
		header CF-IPCountry CN
	}
	respond @cn_block 451

	import common_headers
	import common_encoding
	import reverse_to_sub2api

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

# --- API 子域名：只允许程序化 AI 网关路径 -------------------------------
# 使用白名单，避免未知路径触发 SPA fallback 并向扫描器暴露工作台前端。
api.5566676.xyz {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	@ai_gateway_paths {
		# Core OpenAI / Anthropic / Gemini-compatible gateway routes.
		path /health
		path /v1/*
		path /v1beta/*
		path /responses*
		path /chat/completions
		path /embeddings
		path /images/*
		path /videos/*
		path /alpha/search
		path /backend-api/codex/*
		path /backend-api/anthropic/control-plane/intent
		path /openai/v1/*
		path /openai/_health /openai/_verify /openai/_tls_canary /openai/_tls/canary
		path /antigravity/*

		# Augment-compatible client routes are API traffic, not workbench routes.
		path /usage/api/*
		path /get-models /batch-upload /checkpoint-blobs /find-missing /save-chat
		path /chat /chat-stream /prompt-enhancer /instruction-stream /smart-paste-stream
		path /generate-commit-message-stream /next_edit_loc /next-edit-stream
		path /remote-agents/* /agents/*
		path /get-implicit-external-sources /search-external-sources
		path /context-canvas/* /notifications/* /subscription-banner
		path /report-* /client-* /record-* /chat-feedback /completion-feedback /resolve-*
	}

	handle @ai_gateway_paths {
		import common_headers
		import common_encoding
		import reverse_to_sub2api
	}

	# Unknown paths, SPA routes, static assets, and all management APIs stay dark.
	handle {
		respond 404
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}

# --- HTTP:80 → HTTPS:443 永久重定向 ----------------------------------------
:80 {
	redir https://{host}{uri} permanent
}
